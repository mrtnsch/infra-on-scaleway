# Environment variables consumed by application.yaml placeholders.
# Copy real values into the hosting platform's secret store (deployed) or your shell/IDE (local).
# DO NOT commit a filled-in copy.
#
# Activate a profile in deployed environments:
#   SPRING_PROFILES_ACTIVE=prod
# Local dev defaults to the `local` profile automatically.

# --- Database ---
DB_URL=jdbc:postgresql://localhost:5432/postgres
DB_USERNAME=postgres
DB_PASSWORD=postgres

# --- CORS (comma-separated browser origins allowed to call the API) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173

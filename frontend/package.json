{
  "name": "joke-frontend",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.6.0",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "pnpm generate && vite dev --port 5173 --host 0.0.0.0",
    "build": "pnpm generate && vite build",
    "preview": "vite preview",
    "generate": "pnpm api:generate && pnpm generate-routes",
    "api:generate": "orval --config orval.config.ts",
    "generate-routes": "tsr generate",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write . && eslint --fix",
    "check": "prettier --check .",
    "verify": "pnpm generate && pnpm check && pnpm lint && pnpm typecheck && pnpm test",
    "verify:full": "pnpm verify && pnpm build"
  },
  "dependencies": {
    "@t3-oss/env-core": "^0.13.11",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-devtools": "^0.10.10",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-query-devtools": "^5.101.4",
    "@tanstack/react-router": "^1.170.29",
    "@tanstack/react-router-devtools": "^1.167.1",
    "@tanstack/router-plugin": "^1.168.32",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.31.0",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-error-boundary": "^6.1.3",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tanstack/devtools-vite": "^0.8.3",
    "@tanstack/eslint-config": "^0.4.0",
    "@tanstack/router-cli": "^1.167.30",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.8.1",
    "jsdom": "^30.0.1",
    "orval": "^8.24.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  }
}

# Production build (`pnpm build`).
#
# VITE_* vars are inlined into the bundle at build time, so this file is what
# decides which backend the deployed `dist/` talks to. CI overrides it by
# exporting VITE_API_BASE_URL before `pnpm build` — Vite reads prefixed vars
# from the environment too, and the environment wins over this file.
VITE_API_BASE_URL=http://localhost:8080
